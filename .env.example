# Copy names only. Real secrets stay in the host dashboard, never in git.
# The process does not auto-load this file.

# --- Render (server) ---
HOST=0.0.0.0
PORT=2567
CORS_ORIGIN=https://example.pages.dev
# DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
# CATALOG_FILE overrides apps/server/data/catalog.json
# PLAYER_DATA_DIR=data/players

# --- Cloudflare Pages (client build) ---
# Never put DATABASE_URL or other secrets in VITE_* — they ship to the browser.
# VITE_SERVER_URL=https://example.onrender.com
