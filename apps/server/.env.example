# Shell env only — the server does not load dotenv.
HOST=0.0.0.0
PORT=2567
# Comma-separated browser origins. Local Vite ports are always allowed.
# CORS_ORIGIN=https://example.pages.dev
# Neon / Postgres. Empty keeps embedded PGlite in PLAYER_DATA_DIR.
# DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
# PLAYER_DATA_DIR=data/players
# CATALOG_FILE overrides the shipped apps/server/data/catalog.json
